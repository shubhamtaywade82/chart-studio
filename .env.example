# ───── Binance adapter (public APIs, no creds required) ─────
BINANCE_PRODUCT=usdm

# ───── DhanHQ adapter ─────
# Auth Strategy: totp (default), manual, renew, authority
DHAN_AUTH_MODE=totp

# For 'totp' strategy:
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# For 'authority' strategy:
# rotated tokens from algo_scalper_api running locally.
# Use host.docker.internal from inside containers, or http://127.0.0.1:PORT from the host.
ALGO_SCALPER_URL=
ALGO_SCALPER_API_KEY=

# For 'manual' strategy:
DHAN_ACCESS_TOKEN=

DHAN_FEED_MODE=full

# ───── Gateway ─────
GATEWAY_CORS_ORIGIN=*

# ───── AI Engine (prop desk) ─────
# Ollama/AI Provider endpoint.
# Local: http://localhost:11434
# Cloud: https://api.your-provider.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_DISABLE=0

# Optional API Key (for cloud providers or auth-proxies).
OLLAMA_API_KEY=

# Model overrides (defaults shown).
AI_TACTICAL_MODEL=llama3.1:8b
AI_NARRATIVE_MODEL=llama3.2:3b
AI_RISK_MODEL=codellama:7b
AI_STRATEGIC_MODEL=mixtral:8x7b
AI_EMBED_MODEL=nomic-embed-text

# Throttling (ms).
AI_TACTICAL_INTERVAL_MS=5000
AI_NARRATIVE_INTERVAL_MS=8000
AI_EMBED_INTERVAL_MS=60000

# ───── Trading desk (paper-first; live = read-only stub) ─────
PAPER_START_EQUITY=100000
RISK_MAX_CONCURRENT=5
RISK_DAILY_LOSS_CAP_PCT=5
RISK_MAX_UTIL_PCT=60
# Defaults to 10% of PAPER_START_EQUITY if unset
KILL_SWITCH_LOSS_USD=
