{
  "title": "Chart Studio Metrics",
  "panels": [
    {
      "title": "Chart Tick Latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(chart_tick_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency"
        }
      ]
    },
    {
      "title": "DhanHQ WebSocket Reconnects",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(dhan_ws_reconnect_total[5m])",
          "legendFormat": "Reconnects/sec"
        }
      ]
    },
    {
      "title": "AI Inference Duration (ms)",
      "type": "heatmap",
      "targets": [
        {
          "expr": "sum(rate(ai_inference_duration_ms_bucket[5m])) by (le, tier)",
          "format": "heatmap"
        }
      ]
    },
    {
      "title": "Option Chain Poll Errors",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(option_chain_poll_errors_total[1h])",
          "legendFormat": "Errors (1h)"
        }
      ]
    }
  ]
}
